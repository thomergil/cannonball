# systemd user service. @CHECKOUT@ is the checkout's path; from the checkout:
#   sed "s|@CHECKOUT@|$PWD|g" packaging/linux/cannonball.service > ~/.config/systemd/user/cannonball.service
#   systemctl --user enable --now cannonball
[Unit]
Description=Cannonball: receive photos from Canon EOS cameras over Wi-Fi
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=@CHECKOUT@
ExecStart="@CHECKOUT@/env/bin/python" -m cannonball
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
